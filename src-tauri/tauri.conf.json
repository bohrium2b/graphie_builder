{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graphie Builder",
  "version": "0.1.0",
  "identifier": "com.graphie.builder",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Graphie diagram editor",
    "longDescription": "Graphie Builder is a desktop editor for Khan Academy Graphie diagrams, with live preview and vector export."
  },
  "app": {
    "windows": [
      {
        "title": "Graphie Builder",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' blob:",
        "style-src": "'self' 'unsafe-inline' 'nonce-__TAURI_NONCE__'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: tauri: https://tauri.localhost",
        "worker-src": "'self' blob:",
        "media-src": "'self' blob: data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'self'"
      }
    }
  }
}