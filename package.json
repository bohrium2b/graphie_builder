{
  "name": "graphie-builder",
  "version": "0.1.0",
  "description": "Open-source, cross-platform application for creating professional mathematical and scientific diagrams.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "electron:dev": "concurrently \"yarn dev\" \"wait-on http://localhost:1420 && electron .\"",
    "tauri:build": "cargo tauri build",
    "electron:build": "electron-builder",
    "generate:templates": "node scripts/generate-templates.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-javascript": "^6",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6",
    "@cortex-js/compute-engine": "^0.151.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/inter": "^5.3.0",
    "@mui/icons-material": "^7.3.1",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-clipboard-manager": "~2.5.0",
    "@tauri-apps/plugin-dialog": "~2.8.0",
    "@tauri-apps/plugin-fs": "~2.7.0",
    "@tauri-apps/plugin-shell": "~2",
    "@uiw/react-codemirror": "^4.25.12",
    "esbuild": "^0.28.2",
    "file-saver": "^2.0.5",
    "jspdf": "^3.0.1",
    "konva": "^10.9.0",
    "lucide-react": "^1.60.0",
    "mafs": "^0.21.0",
    "mathlive": "^0.111.1",
    "mathquill": "0.10.1-a",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.3.2",
    "react-resizable-panels": "^3.0.2",
    "satori": "^0.63.2",
    "svelte": "^5.57.2",
    "svg2pdf.js": "^2.3.0",
    "svgo": "^3.3.2",
    "takumi-js": "^2.18.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@rollup/pluginutils": "^5.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "acorn": "^8.14.0",
    "concurrently": "^9.0.0",
    "electron": "^44.9.3",
    "electron-builder": "^25.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.13.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.64.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "productName": "Graphie Builder",
    "appId": "com.graphie_builder.app",
    "icon": "build/icon.png",
    "files": [
      "dist",
      "electron/main.cjs",
      "electron/preload.cjs",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Education",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerHeaderIcon": "build/icon.png",
      "shortcutName": "Graphie Builder"
    },
    "publish": null
  },
  "packageManager": "yarn@4.17.1"
}
